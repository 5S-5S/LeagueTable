{
  "name": "leaguetable-api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create leaguetable",
    "db:schema": "wrangler d1 execute leaguetable --file=./schema.sql",
    "db:schema:remote": "wrangler d1 execute leaguetable --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
